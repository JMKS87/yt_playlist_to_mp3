# Skopiuj do .env (cp .env.example .env) i dostosuj. docker compose czyta .env automatycznie.

# Port na hoście, pod którym aplikacja będzie dostępna (w kontenerze zawsze 5000).
HOST_PORT=5000

# Folder na hoście montowany jako /data (podkatalogi output/ i config/).
# Ścieżka względna liczona od katalogu z docker-compose.yml; może być też bezwzględna.
DATA_DIR=./data

# Użytkownik, jako który działa kontener; ustaw na wynik `id -u` / `id -g`,
# żeby pliki w DATA_DIR miały właściwego właściciela.
UID=1000
GID=1000
